   ],
   "source": [
    "# 함수 => 람다\"식\" = > 익명함수\n",
    "# 함수의 이름을 없애는 대신, 해당 함수를 어떠한 변수 안에는 넣어줘야 함\n",
    "\n",
    "add = lambda a, b :a + b\n",
    "\n",
    "print(add(1, 3))"
   ]
  },
